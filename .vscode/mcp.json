{
  // Single MCP config for the workspace. A second copy under frontend/ lacked `cwd`, which made the
  // Angular CLI MCP resolve the wrong project and serve Angular v20 docs, so do not add one there.
  "servers": {
    // Angular CLI MCP (https://angular.dev/ai/mcp): version-aware docs, best practices, zoneless/OnPush migration.
    "angular-cli": {
      "command": "npx",
      "args": ["-y", "@angular/cli", "mcp"],
      "cwd": "${workspaceFolder}/frontend/portfolio-manager-ui"
    }
  }
}
