{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noPropertyAccessFromIndexSignature": true,
    "types": []
  },
  "include": ["./**/*.ts", "../playwright.config.ts"]
}
