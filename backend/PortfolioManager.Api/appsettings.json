{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=PortfolioManagerLocal;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "PortfolioManager",
    "Audience": "PortfolioManagerClient",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "ScannerSettings": {
    "EodWindowStart": "15:30",
    "EodWindowEnd": "16:30",
    "EodWindowEnabled": true
  },
  "DatabaseBackup": {
    "BackupTimeEt": "14:30",
    "BasePath": "D:\\PORTFOLIO-MANAGER-SQL-BACKUP-ALL\\DAYLY_BACKUP",
    "SqlScriptsSourceDir": ""
  },
  "Automation": {
    "MissedDataRecoveryTimeoutMinutes": 15
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Warning",
        "PortfolioManager.Api.Services.EodAutomationOrchestratorService": "Information",
        "PortfolioManager.Api.Services.AutomationRunCoordinator": "Information",
        "PortfolioManager.Api.Controllers.AutomationController": "Information"
      }
    }
  },
  "AllowedHosts": "*"
}
