{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=PortfolioManagerDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "PortfolioManager",
    "Audience": "PortfolioManagerClient",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "ScannerSettings": {
    "EodWindowStart": "15:30",
    "EodWindowEnd": "16:30",
    "EodWindowEnabled": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
